{
  "manifest_version": 3,
  "name": "AI 套图工作台 采集助手",
  "version": "1.9.0",
  "description": "在你自己的 Chrome 里采集 1688 / 拼多多 / Ozon / WB 商品，自动找 1688 同款，发送到本机运行的 AI 套图工作台。",
  "permissions": [
    "tabs",
    "cookies",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.1688.com/*",
    "*://*.yangkeduo.com/*",
    "*://*.pinduoduo.com/*",
    "*://*.ozon.ru/*",
    "*://*.wildberries.ru/*",
    "*://*.wbbasket.ru/*",
    "*://card.wb.ru/*",
    "*://*.aiprice.com/*",
    "*://*.ozone.ru/*",
    "*://*.alicdn.com/*",
    "*://*.wbcontent.net/*",
    "*://*.wb.ru/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8765/*",
        "http://localhost:8765/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://detail.1688.com/offer/*",
        "*://mobile.yangkeduo.com/goods*",
        "*://*.ozon.ru/*",
        "*://*.wildberries.ru/*"
      ],
      "js": [
        "page-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.1688.com/*",
        "*://*.aiprice.com/*"
      ],
      "js": [
        "netrec.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "AI 套图工作台 采集助手"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
